export const config = { runtime: "nodejs" };

export default async function handler(req, res) {
  if (req.method !== "POST") {
    return res.status(405).json({ error: "Method not allowed" });
  }

  const { text } = req.body || {};
  if (!text) return res.status(400).json({ error: "Missing text" });

  const openaiKey = process.env.OPENAI_API_KEY;
  if (!openaiKey) return res.status(500).json({ error: "Missing API key" });

  try {
    const response = await fetch("https://api.openai.com/v1/audio/speech", {
      method: "POST",
      headers: {
        Authorization: `Bearer ${openaiKey}`,
        "Content-Type": "application/json",
      },
      body: JSON.stringify({
        model: "gpt-4o-mini-tts",
        voice: "alloy",
        input: text,
        format: "base64", // ⚡ يرجع الصوت كـ base64 مباشرة
      }),
    });

    if (!response.ok) {
      const err = await response.text();
      console.error("❌ OpenAI Error:", err);
      return res.status(500).json({ error: "TTS failed", details: err });
    }

    const result = await response.json();
    res.status(200).json({ audio: result.data }); // نرجع الصوت المشفر
  } catch (error) {
    console.error("⚠️ Server error:", error);
    res.status(500).json({ error: "Internal Server Error" });
  }
}
